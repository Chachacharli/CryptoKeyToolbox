@page "/counter"
@using CryptoKeyToolbox.Domain.Entities
@using CryptoKeyToolbox.Domain.Interfaces
@using MudBlazor
@inject ISSHKeyService SSHKeyService

<MudPaper Class="pa-4" Elevation="4">
    <MudText Typo="Typo.h5">SSH Key Generator</MudText>

    <MudTextField @bind-Value="_bits"
                  Label="Key Size"
                  Type="number"
                  Variant="Variant.Outlined" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate">
        Generate SSH Keys
    </MudButton>

    @if (_result != null)
    {
        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Public Key</MudText>
        <MudTextField Value="@_result.PublicKey"
                      Lines="5"
                      ReadOnly="true"
                      Variant="Variant.Outlined" />

        <MudText Typo="Typo.h6" Class="mt-4 mb-2">Private Key</MudText>
        <MudTextField Value="@_result.PrivateKey"
                      Lines="10"
                      ReadOnly="true"
                      Variant="Variant.Outlined" />
    }
</MudPaper>

@code {
    private int _bits = 2048;

    private SSHKeyPair _result;

    private void Generate()
    {
        _result = SSHKeyService.GenerateKey(_bits);
    }
}