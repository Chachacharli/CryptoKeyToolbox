@page "/encryption-keys"
@using CryptoKeyToolbox.Domain.Entities
@using CryptoKeyToolbox.Domain.Interfaces
@using MudBlazor
@inject IJSRuntime JS
@inject IEncryptionKey EncryptionKeyService
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="4">
	<MudText Typo="Typo.h5">Encryption Key Generator</MudText>

	<MudGrid>
		<!-- ALGORITHM -->
		<MudItem xs="12" sm="6">
			<MudSelect T="AlgoritmType"
					   Label="Algorithm"
					   Variant="Variant.Filled"
					   @bind-Value="_algoritmType">

				@foreach (var item in Enum.GetValues(typeof(AlgoritmType)).Cast<AlgoritmType>())
				{
					<MudSelectItem Value="@item">@item.ToString()</MudSelectItem>
				}
			</MudSelect>
		</MudItem>

		<!-- KEY SIZE -->
		<MudItem xs="12" sm="6">
			<MudSelect T="int"
					   Label="Key size"
					   Variant="Variant.Filled"
					   @bind-Value="_keySize">

				@foreach (var size in _states)
				{
					<MudSelectItem Value="@size">@size</MudSelectItem>
				}
			</MudSelect>
		</MudItem>

		<!-- FORMAT -->
		<MudItem xs="12" sm="6">
			<MudSelect T="FormatType"
					   Label="Format"
					   Variant="Variant.Filled"
					   @bind-Value="_formatType">

				@foreach (var fmt in Enum.GetValues(typeof(FormatType)).Cast<FormatType>())
				{
					<MudSelectItem Value="@fmt">@fmt</MudSelectItem>
				}
			</MudSelect>
		</MudItem>

		<!-- COUNT -->
		<MudItem xs="12" sm="6">
			<MudGrid>
				<MudItem xs="12">
					<MudToggleGroup T="int"
									SelectionMode="SelectionMode.SingleSelection"
									@bind-Value="_count"
									Color="Color.Primary"
									FixedContent>

						<MudToggleItem Value="1" Text="1" />
						<MudToggleItem Value="2" Text="2" />
						<MudToggleItem Value="5" Text="5" />
						<MudToggleItem Value="10" Text="10" />

					</MudToggleGroup>
				</MudItem>

				<MudItem xs="12">
					<MudNumericField @bind-Value="_count"
									 Label="Quantity"
									 Variant="Variant.Filled"
									 Min="1" />
				</MudItem>
			</MudGrid>
		</MudItem>
		<MudItem xs="12" md="6">
			<MudButton Class="mt-2"
					   Variant="Variant.Filled"
					   Color="Color.Primary"
					   Disabled="_isLoading"
					   OnClick="Generate">
				Generate
			</MudButton>
		</MudItem>
	</MudGrid>
	@if (_isLoading)
	{
		<div class="d-flex justify-center mt-4 mb-4">
			<MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
		</div>
	}
</MudPaper>

@if (_result != null && !_isLoading)
{
	<MudPaper Class="pa-4 mt-4" Elevation="4">
		<MudText Typo="Typo.h6">Generated Keys</MudText>

		<MudGrid Class="mt-2">
			@foreach (var key in _result)
			{
				<MudItem xs="12" md="6">
					<MudTextField Label="@($"{key.Algorithm} - {key.Format} ({key.KeySize} bits)")"
								  Value="@key.Key"
								  ReadOnly="true"
								  Lines="3"
								  Variant="Variant.Filled" />

					<div class="d-flex justify-end mt-1">
						<MudTooltip Text="Copy private key">
							<MudIconButton Icon="@Icons.Material.Filled.CopyAll"
										   Color="Color.Primary"
										   OnClick="@(() => CopyToClipboard(key.Key))" />
						</MudTooltip>
					</div>

				</MudItem>
			}
		</MudGrid>
	</MudPaper>
}



@code {
	private int _count = 1;
	private int _keySize = 128;

	private AlgoritmType _algoritmType;
	private FormatType _formatType;
	private bool _isLoading = false;

	private readonly int[] _states = { 128, 192, 256 };

	private List<EncryptionKey>? _result;

	private async Task Generate()
	{
		_isLoading = true;
		var generationTask = EncryptionKeyService.GenerateKeys(_algoritmType, _formatType, _keySize, _count);
		var minDelayTask = Task.Delay(1000);

		await Task.WhenAll(generationTask, minDelayTask);

		_result = generationTask.Result;
		_isLoading = false;
	}

	private async Task CopyToClipboard(string text)
	{
		await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
		Snackbar.Add("Copied to clipboard!", Severity.Success);
	}
}
